# Intestazioni HTTP per Cloudflare Pages (le legge da dist/_headers a ogni pubblicazione).
# Il segnaposto della Content-Security-Policy qui sotto viene completato in build da scripts/prerender.mjs.

# ---------- sicurezza, per tutte le pagine e i file ----------
# CSP: il browser esegue solo gli script del sito (più i servizi esterni configurati in src/config.ts)
# X-Frame-Options / frame-ancestors: nessun altro sito può mostrare queste pagine dentro un riquadro
# Permissions-Policy: il sito non chiede mai fotocamera, microfono, posizione, pagamenti
/*
  Content-Security-Policy: __CSP__
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin

# Indirizzi provvisori di Cloudflare (progetto.pages.dev e anteprime): Google non deve indicizzarli,
# altrimenti registra un doppione del sito. Il sito vero è sul dominio.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# ---------- cache ----------
# File con l'impronta del contenuto nel nome (es. index-VH77Fooy.js, cresta-800.3fa9c21b.webp):
# se cambiano, cambia il nome. Si possono tenere in cache un anno senza rischi.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# Pagine e file dal nome fisso: il browser ricontrolla a ogni visita. Se non è cambiato nulla
# la risposta è di pochi byte (304); dopo un aggiornamento arriva subito la versione nuova.
/
  Cache-Control: no-cache
/it/*
  Cache-Control: no-cache
/fr/*
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/docs/*
  Cache-Control: no-cache
/icons/*
  Cache-Control: no-cache
/favicon.svg
  Cache-Control: no-cache
/og-image.jpg
  Cache-Control: no-cache
/site.webmanifest
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: no-cache
/robots.txt
  Cache-Control: no-cache
